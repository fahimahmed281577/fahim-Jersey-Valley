# ============================================================================
# JERSEY VALLEY — ENVIRONMENT VARIABLES REFERENCE (.env.example)
# ============================================================================

# 1. PUBLIC SITE URL & SEO (Optional on Vercel — auto-detected from VERCEL_PROJECT_PRODUCTION_URL)
APP_URL="https://your-production-domain.vercel.app"

# 2. FIREBASE ADMIN SDK CREDENTIALS FOR PRODUCTION PERSISTENCE (Server-Only — NEVER use VITE_ prefix)
# Required in production (NODE_ENV=production / VERCEL=1) so /api/* Serverless Functions persist
# orders (/serverOrders), idempotency locks (/serverIdempotency), variant stock (/serverCatalog),
# stock logs (/serverStockLogs), coupons (/serverCoupons), and settings (/siteSettings/global)
# atomically in Cloud Firestore via firebase-admin transactions.
# Production fails closed with HTTP 503 if these credentials are missing (no silent in-memory fallback).
#
# Option A (Recommended): Paste the entire Firebase Service Account JSON (minified single-line JSON or base64-encoded)
FIREBASE_SERVICE_ACCOUNT_JSON=""
#
# Option B: Or provide the Service Account Client Email and Private Key separately
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# 3. SERVER-SIDE ADMINISTRATOR RBAC (Server-Only — NEVER use VITE_ prefix)
# Mode A — Firebase Administrator Authorization:
# Comma-separated Firebase Auth UIDs granted administrator privileges on /api/admin/*.
# The user must also have email_verified == true in their Firebase ID token.
# Alternatively, create a Firestore document at /admins/{uid} or set custom claim {"admin": true}.
ADMIN_UIDS=""

# Mode B — Standalone Administrator Session (Server-Only — Bcrypt-hashed password + HMAC session secret):
# Used by /api/admin/auth/login to issue an HttpOnly, SameSite=Lax, Secure-in-production session cookie.
ADMIN_LOGIN_ID="jvadmin"
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""

# 4. FIREBASE SERVER & CLIENT OVERRIDES (Optional — defaults to firebase-applet-config.json / jerseyvalley-bd)
# Both FIREBASE_FIRESTORE_DATABASE_ID and FIREBASE_DATABASE_ID are supported on the server.
# Use "(default)" for the standard primary Firestore database, or specify a custom database ID if using a named database.
FIREBASE_PROJECT_ID="jerseyvalley-bd"
FIREBASE_FIRESTORE_DATABASE_ID="(default)"
FIREBASE_DATABASE_ID="(default)"

# Browser-Safe Client Variables (Public Firebase Web SDK config — safe for VITE_ prefix)
VITE_FIREBASE_API_KEY="AIzaSyAEGjQmQ6M9E9iG5IX468_U86xLQJkGXid8"
VITE_FIREBASE_AUTH_DOMAIN="jerseyvalley-bd.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="jerseyvalley-bd"
VITE_FIREBASE_STORAGE_BUCKET="jerseyvalley-bd.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="591799865718"
VITE_FIREBASE_APP_ID="1:591799865718:web:fd6a5f1757ea6453beea57"
VITE_FIREBASE_MEASUREMENT_ID="G-8062XMJBFJ"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"
VITE_FIREBASE_DATABASE_ID="(default)"

# 5. SUPABASE POSTGRESQL CREDENTIALS (Server-Only — NEVER use VITE_ prefix for service role or DB URL)
# Configure these in Vercel Environment Variables once /supabase/migrations/0001_jersey_valley_schema.sql
# has been executed in the Supabase SQL Editor.
SUPABASE_URL="https://xvvdec...supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# Optional direct PostgreSQL connection string (Transaction Pooler port 6543 or Session Pooler port 5432)
SUPABASE_DB_URL=""

# 6. AI STUDIO RUNTIME (Used only inside Google AI Studio preview environment)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
