# ============================================================================
# JERSEY VALLEY — ENVIRONMENT VARIABLES REFERENCE (.env.example)
# ============================================================================

# 1. PUBLIC SITE URL & SEO (Optional on Vercel — auto-detected from VERCEL_PROJECT_PRODUCTION_URL)
APP_URL="https://your-production-domain.vercel.app"

# 2. FIREBASE ADMIN SDK CREDENTIALS FOR SERVERLESS PERSISTENCE (Server-Only — NEVER use VITE_ prefix)
# Required on Vercel so /api/* Serverless Functions persist guest orders (/serverOrders),
# idempotency keys (/serverIdempotency), variant stock (/serverCatalog), and site settings (/siteSettings/global)
# atomically in Cloud Firestore via firebase-admin transactions.
#
# Option A (Recommended): Paste the entire Firebase Service Account JSON (minified single-line JSON or base64-encoded)
FIREBASE_SERVICE_ACCOUNT_JSON=""
#
# Option B: Or provide the Service Account Client Email and Private Key separately
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# 3. SERVER-SIDE ADMINISTRATOR RBAC (Server-Only — Never expose with VITE_ prefix)
# Comma-separated Firebase Auth UIDs granted administrator privileges on /api/admin/*.
# Note: The user must also have email_verified == true in their Firebase ID token.
# Alternatively, create a Firestore document at /admins/{uid} or set custom claim {"admin": true}.
ADMIN_UIDS=""

# 4. FIREBASE SERVER & CLIENT OVERRIDES (Optional — defaults to firebase-applet-config.json)
FIREBASE_PROJECT_ID="circular-valve-x3kqt"
FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-jerseyvalleyfoot-e1da97d7-8072-4f35-96cb-8232f6c69bd4"

VITE_FIREBASE_PROJECT_ID="circular-valve-x3kqt"
VITE_FIREBASE_APP_ID="1:711108477472:web:e72be3aed1fcf7d0373245"
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="circular-valve-x3kqt.firebaseapp.com"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-jerseyvalleyfoot-e1da97d7-8072-4f35-96cb-8232f6c69bd4"
VITE_FIREBASE_STORAGE_BUCKET="circular-valve-x3kqt.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="711108477472"

# 5. OPTIONAL BANGLADESH ONLINE PAYMENT GATEWAYS (Server-Only — Leave empty for COD-only mode)
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""

NAGAD_MERCHANT_ID=""
NAGAD_PG_PUBLIC_KEY=""
NAGAD_MERCHANT_PRIVATE_KEY=""

# 6. AI STUDIO RUNTIME (Used only inside Google AI Studio preview environment)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
