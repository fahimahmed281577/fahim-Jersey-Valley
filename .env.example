# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ADMIN_UIDS: Comma-separated Firebase Auth UIDs granted server-side Administrator access.
# An account must also have email_verified == true in its Firebase ID token.
# Alternatively, create a document at /admins/{uid} in Cloud Firestore or set custom claim {"admin": true}.
ADMIN_UIDS=""

# OPTIONAL BANGLADESH PAYMENT GATEWAY SECRETS (Required only to enable live bKash / Nagad checkout):
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""

NAGAD_MERCHANT_ID=""
NAGAD_PG_PUBLIC_KEY=""
NAGAD_MERCHANT_PRIVATE_KEY=""
