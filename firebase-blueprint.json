{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public and non-sensitive customer profile metadata stored at /users/{userId}",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the customer"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Customer full name"
        },
        "favoriteTeam": {
          "type": "string",
          "maxLength": 60,
          "description": "Optional favorite national team or club"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update"
        }
      },
      "required": ["uid", "displayName", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII document containing email, Bangladesh phone number, and default shipping address stored at /users/{userId}/private/{docId}",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^(\\+?880|0)1[3-9][0-9]{8}$"
        },
        "division": {
          "type": "string",
          "maxLength": 40
        },
        "district": {
          "type": "string",
          "maxLength": 40
        },
        "upazila": {
          "type": "string",
          "maxLength": 60
        },
        "streetAddress": {
          "type": "string",
          "maxLength": 200
        },
        "postalCode": {
          "type": "string",
          "maxLength": 10
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "phone", "division", "district", "upazila", "streetAddress", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator lookup document stored at /admins/{adminUid}",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Football jersey catalog item stored at /products/{productId}",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "slug": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[a-z0-9\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "team": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "category": {
          "type": "string",
          "enum": ["national", "club", "retro"]
        },
        "kitType": {
          "type": "string",
          "enum": ["Home", "Away", "Third", "Retro", "Special"]
        },
        "editionTier": {
          "type": "string",
          "enum": ["Fan Replica", "Player Fit Replica", "Heritage Retro Replica"]
        },
        "gender": {
          "type": "string",
          "enum": ["Men", "Women", "Kids", "Unisex"]
        },
        "season": {
          "type": "string",
          "maxLength": 20
        },
        "priceBdt": {
          "type": "number"
        },
        "customPrintPriceBdt": {
          "type": "number"
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "fabricSpec": {
          "type": "string",
          "maxLength": 200
        },
        "isActive": {
          "type": "boolean"
        },
        "isDemo": {
          "type": "boolean"
        },
        "totalStock": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "team",
        "category",
        "kitType",
        "editionTier",
        "gender",
        "season",
        "priceBdt",
        "customPrintPriceBdt",
        "description",
        "fabricSpec",
        "isActive",
        "isDemo",
        "totalStock",
        "createdAt",
        "updatedAt"
      ]
    },
    "WishlistItem": {
      "title": "WishlistItem",
      "description": "Customer saved wishlist item stored at /users/{userId}/wishlist/{itemId}",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productName": {
          "type": "string",
          "maxLength": 120
        },
        "priceBdt": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "productId", "productName", "priceBdt", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer football jersey order stored at /orders/{orderId}",
      "type": "object",
      "properties": {
        "orderNumber": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "customerPhone": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^(\\+?880|0)1[3-9][0-9]{8}$"
        },
        "division": {
          "type": "string",
          "maxLength": 40
        },
        "district": {
          "type": "string",
          "maxLength": 40
        },
        "upazila": {
          "type": "string",
          "maxLength": 60
        },
        "streetAddress": {
          "type": "string",
          "maxLength": 200
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["COD", "BKASH", "NAGAD"]
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["UNPAID_COD", "PENDING_VERIFICATION", "VERIFIED", "REFUNDED"]
        },
        "orderStatus": {
          "type": "string",
          "enum": ["PENDING_CONFIRMATION", "CONFIRMED", "PROCESSING", "SHIPPED", "DELIVERED", "CANCELLED"]
        },
        "subtotalBdt": {
          "type": "number"
        },
        "shippingBdt": {
          "type": "number"
        },
        "discountBdt": {
          "type": "number"
        },
        "totalBdt": {
          "type": "number"
        },
        "itemCount": {
          "type": "number"
        },
        "itemsSummary": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "orderNumber",
        "userId",
        "customerName",
        "customerPhone",
        "division",
        "district",
        "upazila",
        "streetAddress",
        "paymentMethod",
        "paymentStatus",
        "orderStatus",
        "subtotalBdt",
        "shippingBdt",
        "discountBdt",
        "totalBdt",
        "itemCount",
        "itemsSummary",
        "createdAt",
        "updatedAt"
      ]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global storefront configuration stored at /siteSettings/{settingId}",
      "type": "object",
      "properties": {
        "announcementText": {
          "type": "string",
          "maxLength": 200
        },
        "insideDhakaShippingBdt": {
          "type": "number"
        },
        "outsideDhakaShippingBdt": {
          "type": "number"
        },
        "freeShippingThresholdBdt": {
          "type": "number"
        },
        "bkashMerchantEnabled": {
          "type": "boolean"
        },
        "nagadMerchantEnabled": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "announcementText",
        "insideDhakaShippingBdt",
        "outsideDhakaShippingBdt",
        "freeShippingThresholdBdt",
        "bkashMerchantEnabled",
        "nagadMerchantEnabled",
        "updatedAt"
      ]
    },
    "NewsletterSubscription": {
      "title": "NewsletterSubscription",
      "description": "Customer consent-based newsletter subscription stored at /newsletterSubscriptions/{subId}",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 120
        },
        "consentGiven": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "email", "consentGiven", "createdAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Storefront product category item stored at /categories/{categoryId}",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "slug": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "pattern": "^[a-z0-9\\-]+$"
        },
        "description": {
          "type": "string",
          "maxLength": 200
        },
        "isActive": {
          "type": "boolean"
        },
        "order": {
          "type": "number"
        }
      },
      "required": ["id", "name", "slug", "isActive", "order"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public customer profile document"
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII subcollection for customer phone, email, and Bangladesh shipping address"
    },
    "/users/{userId}/wishlist/{itemId}": {
      "schema": { "$ref": "#/entities/WishlistItem" },
      "description": "Customer wishlist items subcollection"
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted administrator lookup collection"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Storefront product category collections managed by administrators and publicly read by visitors."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Storefront football jersey catalog collection"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders collection with strict ownership and terminal state locking"
    },
    "/siteSettings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Configurable Bangladesh shipping fees, announcement bar, and merchant flags"
    },
    "/newsletterSubscriptions/{subId}": {
      "schema": { "$ref": "#/entities/NewsletterSubscription" },
      "description": "Consent-verified newsletter subscriptions"
    }
  }
}
