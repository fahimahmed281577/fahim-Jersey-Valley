---
export interface Props {
  productId: string;
  alt: string;
  className?: string;
  imageClassName?: string;
  sizes?: string;
  priority?: boolean;
  fallbackColor?: string;
}

const {
  productId,
  alt,
  className = '',
  imageClassName = '',
  sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw',
  priority = false,
  fallbackColor = '#F7F7F5'
} = Astro.props;

const basePath = `/images/products/${productId}`;
const avifSrcSet = `${basePath}-400w.avif 400w, ${basePath}-800w.avif 800w, ${basePath}-1024w.avif 1024w`;
const webpSrcSet = `${basePath}-400w.webp 400w, ${basePath}-800w.webp 800w, ${basePath}-1024w.webp 1024w`;
const jpgSrcSet = `${basePath}-400w.jpg 400w, ${basePath}-800w.jpg 800w, ${basePath}-1024w.jpg 1024w`;
const fallbackSrc = `${basePath}.jpg`;
---

<div
  class={`relative overflow-hidden aspect-square select-none ${className}`}
  style={`background-color: ${fallbackColor};`}
>
  <picture class="w-full h-full block">
    <source type="image/avif" srcset={avifSrcSet} sizes={sizes} />
    <source type="image/webp" srcset={webpSrcSet} sizes={sizes} />
    <img
      src={fallbackSrc}
      srcset={jpgSrcSet}
      sizes={sizes}
      alt={alt}
      width="1024"
      height="1024"
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      referrerpolicy="no-referrer"
      class={`w-full h-full object-cover ${imageClassName}`}
    />
  </picture>
</div>
