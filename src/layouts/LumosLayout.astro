---
export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Jersey Valley — Premium Football Jerseys Bangladesh",
  description = "Shop replica and fan football jerseys in Bangladesh with custom name & number printing, BDT pricing, and nationwide Cash on Delivery.",
  ogImage = "/og-image.jpg"
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Fonts for Lumos & Jersey Valley Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;0,900;1,700&family=JetBrains+Mono:wght@400;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+Bengali:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#F7F7F5] text-[#111111] antialiased selection:bg-[#15803d] selection:text-white min-h-screen flex flex-col">
    <slot name="header" />
    <main class="flex-1 w-full">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
